{
  "name": "@local/dsh-mobile-shell",
  "version": "1.1.0",
  "type": "module",
  "description": "Mobile-friendly shell: off-canvas session drawer, bottom navigation, touch affordances, and a desktop-view escape hatch for desktop-designed plugin pages.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "main": "index.js",
  "author": {
    "name": "RedCarl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedCarl/dsh-mobile-shell.git"
  },
  "homepage": "https://github.com/RedCarl/dsh-mobile-shell",
  "bugs": {
    "url": "https://github.com/RedCarl/dsh-mobile-shell/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "mobile",
    "phone",
    "sidebar",
    "drawer",
    "bottom-navigation"
  ]
}
